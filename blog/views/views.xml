      <field name="code">
        action = {
          "type": "ir.actions.act_window",
          "view_mode": "list,form",
          "res_model": model._name,
        }
      </field>
    </record>
-->

    <menuitem name="Blog Entries" id="blog_entry_menu_root"/>
    <menuitem name="Entries" id="blog_entry_menu_list" parent="blog.blog_entry_menu_root" action="blog.action_window"/>

  </data>
</odoo>
