        {
          "name": "Create - Blog Entry",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"jsonrpc\": \"2.0\",\n    \"method\": \"call\",\n    \"params\": {\n        \"service\": \"object\",\n        \"method\": \"execute_kw\",\n        \"args\": [\n            \"{{odoo_database}}\",\n            {{odoo_uid}},\n            \"{{odoo_password}}\",\n            \"blog.entry\",  // Model name\n            \"create\",  // Method\n            [{\n                \"title\": \"Hola Freelancers!\",\n                \"content\": \"<p>Esto es un hola desde la api</p>\"\n            }]\n        ]\n    }\n}"
            },
            "url": {
              "raw": "{{odoo_base_url}}/jsonrpc",
              "host": [
                "{{odoo_base_url}}"
              ],
              "path": [
                "jsonrpc"
              ]
            },
            "description": "Create a new blog entry using JSON RPC."
          },
          "response": []
        },
        {
          "name": "Update - Blog Entry",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"jsonrpc\": \"2.0\",\n    \"method\": \"call\",\n    \"params\": {\n        \"service\": \"object\",\n        \"method\": \"execute_kw\",\n        \"args\": [\n            \"{{odoo_database}}\",\n            {{odoo_uid}},\n            \"{{odoo_password}}\",\n            \"blog.entry\",  // Model name\n            \"write\",  // Method\n            [[4], {  // IDs to update, fields to update\n                \"content\": \"<b>Contenido actualizado.</b>\"\n            }]\n        ]\n    }\n}"
            },
            "url": {
              "raw": "{{odoo_base_url}}/jsonrpc",
              "host": [
                "{{odoo_base_url}}"
              ],
              "path": [
                "jsonrpc"
              ]
            },
            "description": "Update a blog entry using JSON RPC. Replace [1] with the actual blog entry ID."
          },
          "response": []
        },
