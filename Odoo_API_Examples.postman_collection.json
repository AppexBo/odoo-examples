    {
      "name": "Blog Module - Custom JSON Endpoints",
      "item": [
        {
          "name": "Get Blog Entries (Paginated)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"jsonrpc\": \"2.0\",\n    \"params\": {\n        \"limit\": 10,\n        \"offset\": 0\n    }\n}"
            },
            "url": {
              "raw": "{{odoo_base_url}}/blog/api/entries",
              "host": [
                "{{odoo_base_url}}"
              ],
              "path": [
                "blog",
                "api",
                "entries"
              ]
            },
            "description": "Get paginated list of blog entries. Returns entries with id, title, slug, author_id, and create_date."
          },
          "response": []
        },
        {
          "name": "Get Blog Entry by ID",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"jsonrpc\": \"2.0\",\n    \"params\": {}\n}"
            },
            "url": {
              "raw": "{{odoo_base_url}}/blog/api/entry/1",
              "host": [
                "{{odoo_base_url}}"
              ],
              "path": [
                "blog",
                "api",
                "entry",
                "1"
              ]
            },
            "description": "Get detailed information about a specific blog entry including content and tags. Replace '1' with the actual entry ID."
          },
          "response": []
        },
        {
          "name": "Search Blog Entries",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"jsonrpc\": \"2.0\",\n    \"params\": {\n        \"query\": \"example\",\n        \"limit\": 10\n    }\n}"
            },
            "url": {
              "raw": "{{odoo_base_url}}/blog/api/search",
              "host": [
                "{{odoo_base_url}}"
              ],
              "path": [
                "blog",
                "api",
                "search"
              ]
            },
            "description": "Search blog entries by title. Returns matching entries with id, title, and slug."
          },
          "response": []
        }
      ],
      "description": "Custom JSON endpoints provided by the blog module"
    },
