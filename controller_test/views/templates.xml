<odoo>
  <data>
    <template id="checkout_page" name="checkout_page" inherit_id="website_sale.checkout">
      <xpath expr="//div[@id='shop_checkout']" position="inside">
        <div class="custom-value alert alert-info mb-3" t-if="custom_value">
          <strong>Custom Information:</strong>
          <t t-esc="custom_value" />
        </div>
      </xpath>
    </template>
    <template id="payment_page" name="payment_page" inherit_id="website_sale.payment">
      <xpath expr="//div[@id='payment_method']" position="inside">
        <div class="custom-value alert alert-info mb-3" t-if="custom_value">
          <strong>Custom Information:</strong>
          <t t-esc="custom_value" />
        </div>
      </xpath>
    </template>
  </data>
</odoo>