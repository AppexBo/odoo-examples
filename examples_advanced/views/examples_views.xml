<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="example_record_view_tree" model="ir.ui.view">
            <field name="name">example.record.list</field>
            <field name="model">example.record</field>
            <field name="arch" type="xml">
                <list string="Example Records">
                    <field name="name"/>
                    <field name="value"/>
                    <field name="partner_id"/>
                    <field name="active" invisible="1"/>
                </list>
            </field>
        </record>

        <record id="example_record_view_form" model="ir.ui.view">
            <field name="name">example.record.form</field>
            <field name="model">example.record</field>
            <field name="arch" type="xml">
                <form string="Example Record">
                    <sheet>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="value"/>
                            </group>
                            <group>
                                <field name="partner_id"/>
                                <field name="active"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Description" name="description">
                                <field name="description" placeholder="Enter description..."/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="example_record_view_search" model="ir.ui.view">
            <field name="name">example.record.search</field>
            <field name="model">example.record</field>
            <field name="arch" type="xml">
                <search string="Search Example Records">
                    <field name="name"/>
                    <field name="partner_id"/>
                    <filter string="Active" name="active" domain="[('active', '=', True)]"/>
                    <filter string="Inactive" name="inactive" domain="[('active', '=', False)]"/>
                </search>
            </field>
        </record>

        <record id="action_example_record" model="ir.actions.act_window">
            <field name="name">Example Records</field>
            <field name="res_model">example.record</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="example_record_view_search"/>
        </record>

        <menuitem id="menu_examples_root" name="Examples" sequence="100"/>
        <menuitem id="menu_example_records" name="Example Records" parent="menu_examples_root" action="action_example_record" sequence="10"/>
    </data>
</odoo>